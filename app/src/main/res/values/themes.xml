        <item name="android:windowBackground">@color/zev_background</item>
        <item name="android:statusBarColor">@color/zev_background</item>
        <item name="android:navigationBarColor">@color/zev_background</item>
        <item name="android:colorBackground">@color/zev_background</item>
    </style>
</resources>
